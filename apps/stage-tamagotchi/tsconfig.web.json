{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./src/renderer",
    "composite": true,
    "jsx": "preserve",
    "lib": ["DOM", "ESNext", "DOM.Iterable", "DOM.AsyncIterable"],
    "paths": {
      "@proj-airi/stage-layouts/*": ["../../packages/stage-layouts/src/*"],
      "@proj-airi/stage-ui/*": ["../../packages/stage-ui/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "vitest",
      "vite/client",
      "vite-plugin-vue-layouts/client",
      "vue-macros/macros-global",
      "unplugin-vue-router/client",
      "@types/audioworklet",
      "unplugin-info/client",
      "@proj-airi/stage-shared/electron-renderer"
    ],
    "useDefineForClassFields": true
  },
  "extends": "../../tsconfig.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.d.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.vue",

    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": ["@vue-macros/volar/define-models", "@vue-macros/volar/define-slots"]
  }
}
