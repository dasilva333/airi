# Maintainer: AIRI Team <airi@moeru.ai>
# Standalone PKGBUILD — auto-detects the .deb package in the same directory.
# Usage: place the .deb file alongside this PKGBUILD, then run: makepkg -si

pkgname=airi
pkgrel=1
pkgdesc="AIRI — Self-hosted AI companion for Linux desktop (AiriOS)"
url="https://github.com/moeru-ai/airi"
arch=('x86_64')
license=('MIT')
depends=('electron' 'libnotify' 'libxtst' 'nss' 'gtk3' 'alsa-lib')
optdeps=(
  'xdg-desktop-portal: screen capture support'
  'xdg-desktop-portal-wlr: Wayland screen capture'
  'xdg-desktop-portal-gnome: GNOME screen capture'
  'xdg-desktop-portal-kde: KDE screen capture'
)
conflicts=()
provides=('airi')

# Auto-detect the .deb file in the same directory as this PKGBUILD.
# Picks the most recently modified .deb if multiple are present.
_deb_file="$(find "${startdir}" -maxdepth 1 -name '*.deb' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"

if [[ -z "${_deb_file}" ]]; then
  echo "ERROR: No .deb package found alongside PKGBUILD." >&2
  echo "Place the AIRI .deb file in the same directory as this PKGBUILD and retry." >&2
  exit 1
fi

_deb_basename="$(basename "${_deb_file}")"

# Extract version from the deb filename (e.g. AIRI-0.9.2.linux-amd64.deb -> 0.9.2)
_pkgver="$(
  echo "${_deb_basename}" \
    | grep -oP '(\d+\.)+\d+' \
    | head -1
)"

if [[ -z "${_pkgver}" ]]; then
  echo "WARNING: Could not extract version from '${_deb_basename}', falling back to mtime-based version." >&2
  _pkgver="$(date +%Y.%m.%d)"
fi

pkgver="${_pkgver}"
source=("file:///${_deb_basename}")
md5sums=('SKIP')

package() {
  cd "${srcdir}"

  echo "==> Extracting ${_deb_basename}..."
  ar x "${_deb_basename}"
  tar xf data.tar.xz

  cp -r usr/ "${pkgdir}/"

  install -Dm644 "${pkgdir}/usr/share/applications/ai.moeru.airi.desktop" \
    "${pkgdir}/usr/share/applications/ai.moeru.airi.desktop"

  if [[ -f "${pkgdir}/usr/share/icons/hicolor/512x512/apps/ai.moeru.airi.png" ]]; then
    install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/ai.moeru.airi.png" \
      "${pkgdir}/usr/share/icons/hicolor/512x512/apps/ai.moeru.airi.png"
  fi

  install -Dm755 "${pkgdir}/usr/bin/airi" "${pkgdir}/usr/bin/airi"

  rm -f "${srcdir}"/control.tar.* "${srcdir}"/data.tar.xz "${srcdir}"/debian-binary
}
