{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "jsx": "preserve",
    "lib": ["ESNext"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["vitest", "vite/client", "electron-vite/node", "unplugin-info/client"],
    "useDefineForClassFields": true
  },
  "extends": "../../tsconfig.json",
  "include": [
    "../../uno.config.ts",
    "uno.config.ts",
    "electron.vite.config.ts",

    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/main/**/*.tsx",
    "src/main/**/*.vue",

    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ]
}
