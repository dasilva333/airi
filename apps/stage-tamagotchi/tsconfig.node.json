{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "ESNext"
    ],
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "types": [
      "vitest",
      "vite/client",
      "electron-vite/node",
      "unplugin-info/client",
      "@ergosphere-it/electron/virtual",
      "node"
    ],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/env.d.ts",
    "../../uno.config.ts",
    "uno.config.ts",
    "electron.vite.config.ts",

    "src/launcher/**/*.ts",

    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/main/**/*.tsx",
    "src/main/**/*.vue",

    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ],
  // NOTICE: root tsconfig.json excludes bare "apps"/"apps/**"; in a child config those
  // entries resolve against this child's own directory, i.e. <root>/apps, which is an
  // ancestor of the sources included here and therefore excludes this app's own files.
  // A child-level exclude fully REPLACES the inherited one, so restate the only entries
  // that matter locally.
  "exclude": [
    "node_modules",
    "dist"
  ]
}
