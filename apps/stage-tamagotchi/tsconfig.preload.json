{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "jsx": "preserve",
    "lib": ["DOM", "ESNext"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["vitest", "vite/client", "electron-vite/node", "@proj-airi/stage-shared/electron-renderer"],
    "useDefineForClassFields": true
  },
  "extends": "../../tsconfig.json",
  "include": [
    "electron.vite.config.ts",

    "src/preload/**/*.ts",
    "src/preload/**/*.d.ts",
    "src/preload/**/*.tsx",
    "src/preload/**/*.vue"
  ]
}
