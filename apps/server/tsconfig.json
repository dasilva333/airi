{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "jsx": "preserve",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["vitest", "node"],
    "useDefineForClassFields": true
  },
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
