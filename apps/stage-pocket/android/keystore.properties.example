# Copy this file to keystore.properties (gitignored) and fill in the values.
# Generate the keystore once (from this directory or wherever you keep the .jks):
#   keytool -genkey -v -keystore airi-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias airi
#
# Environment variables override these values:
#   AIRI_KEYSTORE_FILE / AIRI_KEYSTORE_PASSWORD / AIRI_KEY_ALIAS / AIRI_KEY_PASSWORD
storeFile=airi-release.jks
storePassword=
keyAlias=airi
keyPassword=
