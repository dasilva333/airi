{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["ESNEXT"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNEXT"
  },
  "exclude": ["node_modules", "dist"],
  "extends": "../../../tsconfig.json",
  "include": ["src/**/*"]
}
