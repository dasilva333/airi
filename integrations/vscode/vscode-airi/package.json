{
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "airi-vscode.enable",
        "title": "AIRI: Enable"
      },
      {
        "command": "airi-vscode.disable",
        "title": "AIRI: Disable"
      },
      {
        "command": "airi-vscode.status",
        "title": "AIRI: Show Status"
      }
    ],
    "configuration": {
      "properties": {
        "airi-vscode.contextLines": {
          "default": 5,
          "description": "Number of context lines to send (before and after current line)",
          "type": "number"
        },
        "airi-vscode.enabled": {
          "default": true,
          "description": "Enable or disable the AIRI extension",
          "type": "boolean"
        },
        "airi-vscode.gatewayToken": {
          "default": "",
          "description": "AIRI Gateway application key (leave blank to fallback to unauthenticated connections)",
          "type": "string"
        },
        "airi-vscode.sendInterval": {
          "default": 3000,
          "description": "Interval in milliseconds to send updates (0 for real-time)",
          "type": "number"
        }
      },
      "title": "AIRI"
    }
  },
  "description": "Adapter that connects VSCode into Project AIRI",
  "devDependencies": {
    "@guiiai/logg": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-airi/server-sdk": "workspace:*",
    "@types/vscode": "^1.109.0",
    "es-toolkit": "catalog:",
    "injeca": "catalog:",
    "nanoid": "catalog:",
    "tinyexec": "^1.0.2",
    "vscode-ext-gen": "^1.6.0"
  },
  "displayName": "AIRI VSCode adapter",
  "engines": {
    "vscode": "^1.109.0"
  },
  "icon": "res/logo.jpg",
  "main": "./dist/extension.cjs",
  "name": "vscode-airi",
  "preview": true,
  "private": true,
  "publisher": "proj-airi",
  "repository": {
    "directory": "integrations/vscode/vscode-airi",
    "type": "git",
    "url": "https://github.com/moeru-ai/airi.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "pnpm run update",
    "publish": "tsx ./scripts/publish.ts",
    "typecheck": "tsc --noEmit",
    "update": "tsx ./scripts/vscode-ext-gen.ts"
  },
  "type": "module",
  "version": "0.9.0-alpha.15"
}
