{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "types": ["@types/audioworklet"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
