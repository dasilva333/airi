{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["DOM", "ESNext", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["vitest", "vite/client", "unplugin-info/client", "@types/audioworklet"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["dist", "node_modules"],
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/**/*.story.vue",
    "stories/**/*.ts",
    "stories/**/*.d.ts",
    "stories/**/*.vue",
    "stories/**/*.story.vue"
  ],
  "vueCompilerOptions": {
    "plugins": ["@vue-macros/volar/define-models", "@vue-macros/volar/define-slots"],
    "skipTemplateCodegen": false
  }
}
