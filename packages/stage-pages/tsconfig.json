{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["DOM", "ESNext", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "paths": {
      "@proj-airi/electron-vueuse": ["../../packages/electron-vueuse/src/index.ts"],
      "@proj-airi/electron-vueuse/*": ["../../packages/electron-vueuse/src/*"],
      "@proj-airi/stage-layouts": ["../../packages/stage-layouts/src/index.ts"],
      "@proj-airi/stage-layouts/*": ["../../packages/stage-layouts/src/*"],
      "@proj-airi/stage-ui/*": ["../../packages/stage-ui/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["vitest", "vite/client", "unplugin-info/client"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["dist", "node_modules"],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "vueCompilerOptions": {
    "plugins": ["@vue-macros/volar/define-models", "@vue-macros/volar/define-slots"],
    "skipTemplateCodegen": false
  }
}
