{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["vitepress/client", "vue"]
  },
  "exclude": ["node_modules"],
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "/**/*.vue",
    "components/**/*.vue",
    ".vitepress/**/*.vue",
    "/**/*.ts",
    "/**/*.md",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}
