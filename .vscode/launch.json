{
  "compounds": [
    {
      "configurations": ["Debug Electron", "Debug Renderer Process"],
      "name": "Debug All",
      "presentation": {
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      // Open terminal when debugging starts (Optional)
      // Useful to see console.logs
      // "console": "integratedTerminal",
      // "internalConsoleOptions": "neverOpen",
      "env": {
        "REMOTE_DEBUGGING_PORT": "9222"
      },
      "name": "Debug Electron",
      "request": "launch",
      "runtimeArgs": ["-F", "@proj-airi/stage-tamagotchi", "exec", "electron-vite", "--sourcemap"],
      // Where to run the command
      "runtimeExecutable": "pnpm",
      "type": "node"
    },
    {
      "args": ["--env-file=.env", "--env-file-if-exists=.env.local", "src/main.ts"],
      "envFile": "${workspaceFolder}/services/minecraft/.env",
      "name": "Debug Minecraft Service",
      "request": "launch",
      "runtimeArgs": ["-F", "@proj-airi/minecraft-bot", "exec", "tsx"],
      // Where to run the command
      // Where to run the command
      "runtimeExecutable": "pnpm",
      // Open terminal when debugging starts (Optional)
      // Useful to see console.logs
      // "console": "integratedTerminal",
      // "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Debug Renderer Process",
      "port": 9222,
      "presentation": {
        "hidden": true
      },
      "request": "attach",
      "timeout": 60000,
      "type": "chrome",
      "webRoot": "${workspaceFolder}/src/renderer"
    },
    {
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/plugins/airi-plugin-vscode"],
      "name": "Debug VSCode Extension",
      "outFiles": ["${workspaceFolder}/plugins/airi-plugin-vscode/dist/**/*.cjs"],
      "request": "launch",
      "type": "extensionHost"
    }
  ],
  "version": "0.2.0"
}
